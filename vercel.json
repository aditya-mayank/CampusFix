{
  "version": 2,
  "installCommand": "npm --prefix src ci && npm --prefix backend ci",
  "buildCommand": "npm run build",
  "outputDirectory": "src/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
